# Google Analytics 4 — set at build time (Vite exposes only VITE_* to the client).
# Example: VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Local production build: VITE_GA_MEASUREMENT_ID=G-... npm run build
# GitHub Actions: add repo secret VITE_GA_MEASUREMENT_ID (Settings → Secrets and variables → Actions).
# Leave unset to disable GA (no gtag scripts).

VITE_GA_MEASUREMENT_ID=
